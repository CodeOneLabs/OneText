flowchart TD
    entry["BenchSuite.RunAll"] --> burst["UnderBurst: BenchScene.ForceBurst"]
    burst --> run["BenchSuite.Run(subjects, repeats=3): ForceBurst again + WarmBurst"]
    others["Breakdown / BreakdownWorldSpace / WorkloadMatrix / SystemFallback: UnderBurst, one scenario directly, no Repeat"] --> scen
    run --> subj["OneTextSubject.Setup: fonts, OneTextSettings, SharedGlyphAtlas.Reconfigure"]
    subj --> scen["BenchScenarios.ChatStream / GlobalUi / WorldSpaceLabels / Churn"]
    scen --> corpus["BenchCorpus (seeded, 60% reuse)"]
    scen --> frame["BenchScene.Frame(subject, mutate)"]
    frame --> f1["mutate: subject.SetText"]
    f1 --> f2["Canvas.ForceUpdateCanvases"]
    f2 --> f3["subject.EndFrame: AtlasFlushScheduler.FlushNow"]
    f3 --> f4["FrameSample: ms, alloc bytes, DrawGroups, Graphics"]
    f4 --> runres["BenchRun: Samples, Median, P99, MeanBytes, Coverage"]
    runres --> repeat["Repeat: keep the middle run by p99"]
    repeat --> report["BenchReport.Write: bench-report.md + CSV per run"]
