flowchart LR
    S["string (label text)"] --> P["Layout: RichTextParser.Parse, EscapeParser.Unescape"]
    P --> R["RichTextResult: plain text plus TextStyleSpan list"]
    R --> A1["Unicode: LineBreaker.Analyze (UAX 14)"]
    A1 --> A2["Unicode: DictionaryLineBreaker.Apply, AsianTypography tailorings"]
    A2 --> A3["Unicode: TextSegmenter.GraphemeBoundaries (UAX 29)"]
    A3 --> A4["Unicode: BidiRuns.GetLogicalRuns (UAX 9)"]
    A4 --> I["Layout: TextLayoutEngine.BuildItems (font, style, direction per run)"]
    I --> SH["Shaping: Shaper.Shape, calling Native HarfBuzzApi.hb_shape"]
    SH --> G["List of ShapedGlyph, in font units"]
    G --> L["Layout: TextLayoutEngine wraps, aligns, justifies"]
    L --> TR["TextLayoutResult: Glyphs, Runs, Lines, GraphemeStarts"]
    TR --> RZ["Rendering: OutlineExtractor, GlyphRasterizer (SDF or MSDF, Burst)"]
    RZ --> AT["Rendering: GlyphAtlas.GetOrAdd returns GlyphLocation"]
    AT --> Q["Layout: TextQuad list (Animation TextAnimator may modify)"]
    Q --> F["Frontend: Runtime/UGUI OneTextLabel, Runtime/Mesh OneTextMesh"]
