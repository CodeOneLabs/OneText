flowchart TD
    BAKE["Label builds quads with starting atlas versions"] --> MOVE["Atlas evicts or compacts: Version++"]
    MOVE --> TICK["LateUpdate / editor update polls versions"]
    MOVE --> POST["Play mode: willRenderCanvases after registry graphic pass"]
    TICK --> DIRTY["SetVerticesDirty on registered graphics"]
    POST --> GUARD{"Already repairing or inside a rebuild?"}
    GUARD -- yes --> SKIP["Skip nested callback"]
    GUARD -- no --> CMP{"Atlas versions changed?"}
    CMP -- yes --> LIMIT{"Repair budget remains?"}
    LIMIT -- yes --> DIRTY
    DIRTY --> REBUILD["Next canvas pass rebuilds stale quad caches"]
    POST -. "up to 4 repair passes" .-> FORCE["ForceUpdateCanvases before drawing"]
    FORCE --> REBUILD
    REBUILD --> FLUSH["LatePreRender uploads relocated atlas tiles"]
    FLUSH --> CMP
    CMP -- no --> VALID{"Every label cache matches its atlas?"}
    LIMIT -- no --> VALID
    VALID -- yes --> DRAW["Draw current glyph meshes"]
    VALID -- no --> CLEAR["Clear stale renderers; dirty vertices and material for next frame"]
    CLEAR --> DRAW
